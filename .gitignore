# ==========================================================
# Organiza — .gitignore
# Android/Kotlin · Gradle · Rust/Native · IDEs · Claude
# ==========================================================

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo

# ---------- Secrets & local config (NEVER commit) ----------
local.properties
.env
.env.*
!.env.example
*.keystore
*.jks
!debug.keystore
keystore.properties
signing.properties
google-services.json
*.pem
*.p12
*.key
secrets/
# BYOK: user API keys must never land in the repo
**/groq*.key
**/*api_key*

# ---------- Gradle ----------
.gradle/
**/build/
!src/**/build/
gradle-app.setting
.gradletasknamecache
!gradle/wrapper/gradle-wrapper.jar
.kotlin/
*.hprof

# ---------- Android ----------
*.apk
*.xapk
*.aab
*.ap_
*.dex
*.class
captures/
.externalNativeBuild/
.cxx/
output.json
output-metadata.json
lint-results*.html
lint-results*.xml
**/release/
**/debug/
!**/src/debug/
!**/src/release/
proguard/
*.log
# Android Studio Navigation editor temp files
.navigation/

# ---------- Kotlin / JVM ----------
out/
bin/
*.iml
hs_err_pid*

# ---------- Rust / Native ----------
target/
**/target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed for binaries/apps; uncomment for pure libraries
# Cargo.lock
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.obj
jniLibs/**/*.so
.cargo/registry/
.cargo/git/

# ---------- SQLCipher / local data (dev artifacts) ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- IDEs ----------
.idea/
!.idea/codeStyles/
!.idea/inspectionProfiles/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.fleet/
*.code-workspace

# ---------- Node (tooling scripts) ----------
node_modules/

# ---------- Coverage / test output ----------
coverage/
*.profraw
*.profdata
lcov.info
jacoco.exec

# ---------- Claude ----------
.claude/settings.local.json
.claude/*.local.*
.claude/cache/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
CLAUDE.local.md

# Sideload copies made by :app:android:dogfoodApks
dist/

# Screenshots the taste-skill inspector writes while reviewing a page.
.taste-skill/**/inspect/
