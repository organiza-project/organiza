<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checksums for the one dependency that comes from JitPack, which builds straight from GitHub
  (ADR-0018). Every other artifact is trusted as before. After changing the Tesseract version, run
  Gradle with the write-verification-metadata option (sha256) and check the new values by hand.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]github[.]adaptech-cz).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.github.adaptech-cz.Tesseract4Android" name="tesseract4android" version="4.8.0">
         <artifact name="tesseract4android-4.8.0.aar">
