         </artifact>
         <artifact name="tesseract4android-4.8.0.module">
            <sha256 value="b593ef9cbc0f49af0948679b090aebcee2e4bc7159aefbec5bd11453ddb30e41" origin="Downloaded from JitPack and checked on 2026-11-03"/>
         </artifact>
         <artifact name="tesseract4android-4.8.0.pom">
            <sha256 value="802f9b70226cbd48a4b471da296715abbc3d0adc9789f37296267399697af800" origin="Downloaded from JitPack and checked on 2026-11-03"/>
