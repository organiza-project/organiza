[Unit]
Description=Organiza Background Focus and Habit Tracker
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/organiza --background
Restart=on-failure
RestartSec=5s
Environment=GDK_BACKEND=x11,wayland

[Install]
WantedBy=graphical-session.target
