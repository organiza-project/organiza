# Copy to .env, or let make-keys.sh write .env with fresh secrets (recommended).
# The address the app is given, without a trailing slash. Must be https:// for the app to accept it.
PUBLIC_URL=https://organiza.example.com
# A domain gets an automatic certificate (set HTTP_PORT=80 and HTTPS_PORT=443 for that);
# :80 serves plain HTTP for a reverse proxy you already run.
SITE_ADDRESS=:80
HTTP_PORT=8000
HTTPS_PORT=8443
# Letters and digits only: it goes into SQL as it is. make-keys.sh picks one for you.
POSTGRES_PASSWORD=
JWT_SECRET=
# The key you paste into the app. It is public by design; JWT_SECRET is the one to protect.
ANON_KEY=
# Set true once your accounts exist, so no one else can sign up on a public address.
DISABLE_SIGNUP=false
AUTOCONFIRM=true
