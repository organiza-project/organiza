# Organiza focus enforcement daemon (ADR-0013).
[Unit]
Description=Organiza focus enforcement
After=network.target

[Service]
ExecStart=/opt/organiza/bin/organiza daemon
User=root
Group=organiza
# The control socket lives here, readable only by root and the organiza group.
RuntimeDirectory=organiza
RuntimeDirectoryMode=0750
StateDirectory=organiza
StateDirectoryMode=0700
# The database key, sealed by systemd-creds with the host key and the TPM when present.
LoadCredentialEncrypted=organiza-db-key:/etc/organiza/db-key.cred
# A crash or a kill brings it straight back. A deliberate `systemctl stop` is recorded on return.
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
# Not "full" or "strict": the daemon must be able to write /etc/hosts.
ProtectSystem=true

[Install]
WantedBy=multi-user.target
